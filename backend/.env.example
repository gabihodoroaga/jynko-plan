# Core Server & Environment (strictly: dev | stg | prd)
PORT=8082
ENV=dev
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)

# Optional Firestore Root Collection Override (defaults to <PROJECT_PREFIX>-<ENV>-projects, e.g. jp-prd-projects)
PROJECT_PREFIX=jp
PROJECTS_COLLECTION=

# Google Cloud IAP / OIDC Verification (required in stg/prd to prevent cross-service JWT replay)
# Direct Cloud Run IAP audience format: /projects/<PROJECT_NUMBER>/locations/<REGION>/services/<SERVICE_NAME>
# External LB IAP audience format:      /projects/<PROJECT_NUMBER>/global/backendServices/<BACKEND_SERVICE_ID>
IAP_AUDIENCE=
IAP_REQUIRE_JWT=false

# File Attachments Storage (required in stg/prd so uploads persist across Cloud Run scale-to-zero)
ATTACHMENTS_GCS_BUCKET=
LOCAL_STORAGE_DIR=data/attachments

# Static SPA Serving & Startup Seeding (SEED_ON_STARTUP defaults to true in dev, false in stg/prd)
STATIC_DIR=
SEED_ON_STARTUP=

# Local Dev Auth Fallback (used strictly when ENV=dev)
DEV_USER_ID=dev-user-1
DEV_USER_EMAIL=dev@jynko.local
DEV_USER_NAME=Local Developer
CORS_ALLOWED_ORIGINS=http://localhost:4202,http://127.0.0.1:4202,http://localhost:4200,http://127.0.0.1:4200

# Observability (Cloud Trace & Cloud Monitoring default to true when ENV=prd)
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_CLOUD_TRACE=
ENABLE_CLOUD_METRICS=
ENABLE_PROMETHEUS_METRICS=true
OTEL_SAMPLE_RATIO=1.0
