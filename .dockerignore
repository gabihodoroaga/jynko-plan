# Version control and editor
.git
.github
.gitignore
.agents
.vscode
.idea
*.swp
*.swo
.DS_Store
**/.DS_Store

# Documentation and operational scripts
docs/
scripts/
*.md

# Backend exclusions
backend/bin/
backend/dist/
backend/internal/e2e/screenshots/
