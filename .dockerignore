backend/ui-validator

# Frontend exclusions
frontend/node_modules/
frontend/.angular/
frontend/dist/
frontend/.editorconfig
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.cache/
frontend/coverage/
